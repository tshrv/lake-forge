{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Data Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/data_generator",
            "args": [
                "--scale-factor",
                "${input:scaleFactor}",
                "--create-db",
                "${input:createDb}"
            ],
            "python": "${workspaceFolder}/data_generator/.venv/bin/python"
        }
    ],
    "inputs": [
        {
            "id": "scaleFactor",
            "type": "pickString",
            "description": "Enter scale factor",
            "options": [
                "1",
                "10",
                "100"
            ],
            "default": "1"
        },
        {
            "id": "createDb",
            "type": "pickString",
            "description": "Create a database",
            "options": [
                {
                    "label": "Yes",
                    "value": "True"
                },
                {
                    "label": "No",
                    "value": "False"
                }
            ],
            "default": "False"
        }
    ]
}