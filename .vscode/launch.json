{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Data Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/data_generator",
            "args": [
                "--data-dir-name",
                "${input:dataDirName}",
                "--scale-factor",
                "${input:scaleFactor}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "scaleFactor",
            "type": "pickString",
            "description": "Enter scale factor",
            "options": [
                "1",
                "10",
                "100"
            ],
            "default": "1"
        },
        {
            "id": "dataDirName",
            "type": "pickString",
            "description": "Enter data directory name",
            "options": [
                "data_sf_1",
                "data_sf_10",
                "data_sf_100"
            ],
            "default": "data_sf_1"
        }
    ]
}